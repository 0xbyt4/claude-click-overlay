{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__computer-use__(left_click|right_click|middle_click|double_click|triple_click|left_click_drag|scroll|computer_batch)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/hooks/hook.py pre",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__computer-use__(left_click|right_click|middle_click|double_click|triple_click|left_click_drag|scroll|mouse_move|computer_batch)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/hooks/hook.py post",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
